   "source": [
    "import openml\n",
    "\n",
    "datasets = openml.datasets.list_datasets()\n",
    "\n",
    "dataset_name = \"iris\"\n",
    "\n",
    "dataset_ids = [\n",
    "    did for did, d in datasets.items()\n",
    "    if d[\"name\"].lower() == dataset_name.lower()\n",
    "]\n",
    "\n",
    "print(dataset_ids)\n"
   ]
  }
 ],
